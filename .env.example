# Groq (transcription via Whisper) — https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here

# Google Gemini (viral moment detection) — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Optional model overrides
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo   # or whisper-large-v3
# GEMINI_MODEL=gemini-3.5-flash

# Keeps Docker container names stable (autoclipper-backend / -frontend)
COMPOSE_PROJECT_NAME=autoclipper

# --- Auth (user accounts + per-user API keys) ---
# Secret used to sign JWTs AND to encrypt stored API keys at rest.
# Set a long random value and keep it identical across backend restarts/replicas.
# CHANGE THIS to a long random string in production.
AUTOCLIPPER_SECRET=change-me-to-a-long-random-string
# Optional local key-file override when AUTOCLIPPER_SECRET is unset.
# Defaults to <AUTOCLIPPER_DB>.fernet-key beside the SQLite database.
# Upgrading from the old ephemeral-key build? Credentials encrypted with the
# previous random key cannot be recovered; the Settings page lists exactly
# which ones must be saved again (see README "Accounts & Per-User API Keys").
# AUTOCLIPPER_SECRET_FILE=
# Token lifetime in minutes (default 1440 = 24h)
# AUTOCLIPPER_TOKEN_MINUTES=1440
# Path to the SQLite user database (optional)
# AUTOCLIPPER_DB=autoclipper.db

# --- Voice-over (Kokoro TTS local model cache) ---
# Where the Kokoro ONNX model is cached (Docker volume by default).
# KOKORO_CACHE=/app/models/kokoro

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Groq audio upload limit in MB (free tier 25, dev tier 100). Audio is chunked below this.
# GROQ_MAX_AUDIO_MB=24

# Burned-in subtitle styling (optional)
# SUBTITLE_FONT=Arial
# SUBTITLE_FONT_SIZE=80
# SUBTITLE_WORDS_PER_CUE=1          # words shown per caption (1 = word-by-word)
# SUBTITLE_MARGIN_V=120

# --- Visual frame sampling (multimodal analysis) ---
# All values are hard-bounded in code; overrides outside the bounds are clamped.
# AUTOCLIPPER_MAX_ANALYSIS_FRAMES=8          # 1..16, cap per sampling pass
# AUTOCLIPPER_MIN_ANALYSIS_FRAMES=3          # 1..MAX, floor for short videos
# AUTOCLIPPER_VISUAL_SAMPLE_INTERVAL_SECONDS=90  # 5..900, seconds per frame on long videos
# AUTOCLIPPER_MAX_FRAME_BYTES=600000         # per-frame JPEG payload cap
# AUTOCLIPPER_MAX_TOTAL_FRAME_BYTES=4000000  # total payload cap per pass
# AUTOCLIPPER_MAX_SAMPLING_SECONDS=18        # wall-time cap per pass
# AUTOCLIPPER_FRAME_TIMEOUT_SECONDS=3        # per-frame FFmpeg timeout
# AUTOCLIPPER_MAX_FRAME_DIMENSION=640        # 128..1920, longest edge in px
